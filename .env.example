# ────────────────────────────────────────────────────────────────
# Aircargo secrets — copy this file to `.env` and fill in real values.
# `.env` is gitignored: NEVER commit it.
#
#   cp .env.example .env
#   JWT_SECRET:        openssl rand -base64 64
# ────────────────────────────────────────────────────────────────

# ── JWT (min 32 chars, generate with: openssl rand -base64 64) ──
JWT_SECRET=change-me-openssl-rand-base64-64

# ── PostgreSQL (matches docker/docker-compose.infrastructure.yml) ──
POSTGRES_DB=aircargo_db
POSTGRES_USER=aircargo_user
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# ── RabbitMQ (matches docker/docker-compose.infrastructure.yml) ──
RABBITMQ_USER=aircargo
RABBITMQ_PASSWORD=change-me

# ── Ports (host) ──────────────────────────────────
FRONTEND_PORT=80
BACKEND_PORT=9091

# ── CORS (comma-separated origins) ───────────────
CORS_ORIGINS=http://localhost,http://localhost:80

# ── Java heap (for t3.small: 512m, t3.medium: 1g) ──
JAVA_OPTS=-Xms256m -Xmx512m
